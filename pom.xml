<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.sumitvairagar</groupId>
    <artifactId>sagacity-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Sagacity</name>
    <description>SAGA semantics for AI agents: declarative compensation for Spring AI tool calls with a tamper-evident audit trail</description>
    <url>https://github.com/sumitvairagar/sagacity</url>

    <!--
      groupId is io.github.sumitvairagar rather than dev.sagacity because Central
      requires a verified namespace and sagacity.dev is not obtainable. Java
      packages deliberately stay dev.sagacity.* — coordinates can change again
      later (for example if this moves to spring-ai-community) without breaking
      a single import in user code.
    -->

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>sumitvairagar</id>
            <name>Sumit Vairagar</name>
            <url>https://github.com/sumitvairagar</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/sumitvairagar/sagacity.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/sumitvairagar/sagacity.git</developerConnection>
        <url>https://github.com/sumitvairagar/sagacity</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/sumitvairagar/sagacity/issues</url>
    </issueManagement>

    <modules>
        <module>sagacity-core</module>
        <module>sagacity-spring-ai</module>
        <module>sagacity-spring-boot-starter</module>
        <module>sagacity-examples</module>
        <!-- Last: aggregates coverage over everything above -->
        <module>sagacity-coverage</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!--
          Must stay on the Spring Framework 7 line that Spring AI 2.0.0 compiles
          against. Boot 3.5.x pulls Spring Framework 6.2, which downgrades
          spring-core underneath Spring AI and fails at runtime with
          NoClassDefFoundError: org/springframework/core/Nullness.
        -->
        <spring-boot.version>4.0.2</spring-boot.version>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <jacoco.version>0.8.12</jacoco.version>
        <maven-failsafe.version>3.2.5</maven-failsafe.version>
        <maven-source.version>3.3.1</maven-source.version>
        <maven-javadoc.version>3.11.2</maven-javadoc.version>
        <maven-gpg.version>3.2.7</maven-gpg.version>
        <central-publishing.version>0.7.0</central-publishing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.sumitvairagar</groupId>
                <artifactId>sagacity-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.sumitvairagar</groupId>
                <artifactId>sagacity-spring-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-model</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Spring AI binds tool-call JSON arguments by parameter name -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!--
              *IT tests need Docker and run under `mvn verify`, not `mvn test`.
              Testcontainers skips them when no daemon is reachable, so a build
              without Docker still passes.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Per-module coverage plus an aggregate report over every module,
              written to sagacity-coverage/target/site/jacoco-aggregate.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Everything Central requires that a normal build should not pay for:
          sources jar, javadoc jar and GPG signatures. Activate with -Prelease.

          Publishing:
            mvn -Prelease clean deploy
          Needs a GPG key whose public half is on a keyserver, and a Central
          Portal user token in ~/.m2/settings.xml under <server><id>central</id>.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Fail the release on broken javadoc, not on missing tags -->
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                              Leaves the bundle in the Portal for a human to
                              review and release. Flip to true only once a
                              release has gone through cleanly by hand —
                              published coordinates can never be taken back.
                            -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
